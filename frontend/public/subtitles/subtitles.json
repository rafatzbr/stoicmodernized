{
  "segments": [
    {
      "start_time": 0.1,
      "end_time": 3.85,
      "text": "Finance wants cost, Marketing wants speed.",
      "words": null
    },
    {
      "start_time": 3.85,
      "end_time": 5.6,
      "text": "They disagree.",
      "words": null
    },
    {
      "start_time": 5.6,
      "end_time": 8.2,
      "text": "You panic and think they hate you.",
      "words": null
    },
    {
      "start_time": 8.2,
      "end_time": 9.8,
      "text": "They don't.",
      "words": null
    },
    {
      "start_time": 9.8,
      "end_time": 12.737,
      "text": "That friction isn't personal rejection.",
      "words": null
    },
    {
      "start_time": 12.737,
      "end_time": 15.112,
      "text": "It's just role conflict.",
      "words": null
    },
    {
      "start_time": 15.112,
      "end_time": 19.537,
      "text": "Finance is paid to cut costs; Marketing is paid to grow.",
      "words": null
    },
    {
      "start_time": 19.537,
      "end_time": 24.425,
      "text": "If you try to please both, you burn out trying to control the uncontrollable.",
      "words": null
    },
    {
      "start_time": 24.425,
      "end_time": 26.375,
      "text": "The Stoic move?",
      "words": null
    },
    {
      "start_time": 26.375,
      "end_time": 28.675,
      "text": "Stop apologizing.",
      "words": null
    },
    {
      "start_time": 28.675,
      "end_time": 30.962,
      "text": "Stop over-explaining.",
      "words": null
    },
    {
      "start_time": 30.962,
      "end_time": 35.825,
      "text": "Your job is to do the right thing for your role, not to be everyone's friend.",
      "words": null
    },
    {
      "start_time": 35.825,
      "end_time": 39.712,
      "text": "When you stop seeking validation, you gain respect.",
      "words": null
    },
    {
      "start_time": 39.712,
      "end_time": 45.412,
      "text": "Your leaders will say, 'We need more people like him,' even if you never asked for the spotlight.",
      "words": null
    },
    {
      "start_time": 45.412,
      "end_time": 48.1,
      "text": "Calm isn't avoiding conflict.",
      "words": null
    },
    {
      "start_time": 48.1,
      "end_time": 51.112,
      "text": "It's knowing the disagreement isn't about you.",
      "words": null
    },
    {
      "start_time": 51.112,
      "end_time": 53.05,
      "text": "It's about the job.",
      "words": null
    },
    {
      "start_time": 53.05,
      "end_time": 56.1,
      "text": "Where do you feel this approval pressure most?",
      "words": null
    },
    {
      "start_time": 56.1,
      "end_time": 57.8,
      "text": "Tell me below.",
      "words": null
    },
    {
      "start_time": 57.8,
      "end_time": 63.264,
      "text": "Subscribe to @stoic-modernized for practical Stoic tools you can use at work.",
      "words": null
    }
  ]
}