# Stoic Modernized - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Mode Settings
# =============================================================================

# Enable mock mode for all stages (works without API keys)
# Even in mock mode, the local pipeline can still emit real WAV/JPG/SRT/MP4 assets.
# Set to true for testing/demo, false for production use.
MOCK_MODE=false

# =============================================================================
# TTS Configuration
# =============================================================================

# TTS Provider: local, edge, or elevenlabs
TTS_PROVIDER=local

# TTS Voice name
# For edge-tts, a good default is en-US-GuyNeural
TTS_VOICE=en-US-GuyNeural

# TTS Speed: 0.5 to 2.0 (1.0 = normal)
TTS_SPEED=1.0

# ElevenLabs API Key (required if TTS_PROVIDER=elevenlabs)
# Get one at: https://elevenlabs.io
# TTS_API_KEY=your_elevenlabs_api_key_here

# =============================================================================
# YouTube Configuration
# =============================================================================

# YouTube Data API Key (required for real upload)
# Get one at: https://console.cloud.google.com/apis/credentials
# YOUTUBE_API_KEY=your_youtube_api_key_here

# Default privacy status: public, unlisted, private
YOUTUBE_PRIVACY_STATUS=unlisted

# Optional: Schedule video for specific datetime (ISO 8601 format)
# YOUTUBE_SCHEDULE_DATETIME=2024-04-01T10:00:00+00:00

# =============================================================================
# Video Settings
# =============================================================================

# Output resolution (currently hardcoded to 1920x1080 in config)
# VIDEO_WIDTH=1920
# VIDEO_HEIGHT=1080
# VIDEO_FPS=30

# Background music volume: 0.0 to 1.0
BACKGROUND_MUSIC_VOLUME=0.15

# =============================================================================
# Image Generation (Stable Diffusion CLI)
# =============================================================================

# Path to sd-cli executable
SD_CLI_PATH=/home/rafatz/dev/stable-diffusion.cpp/build/bin/sd-cli

# Stable Diffusion model paths
SD_MODEL_PATH=/data/sd-models/sd3.5_large.safetensors
SD_CLIP_L_PATH=/data/sd-models/clip_l.safetensors
SD_CLIP_G_PATH=/data/sd-models/clip_g.safetensors
SD_T5XXL_PATH=/data/sd-models/t5xxl_fp16.safetensors

# Image generation settings
SD_IMAGE_WIDTH=1080
SD_IMAGE_HEIGHT=1920  # Vertical for YouTube Shorts/Reels
SD_CFG_SCALE=4.5
SD_STEPS=40
SD_SAMPLING_METHOD=euler
SD_NEGATIVE_PROMPT=blurry, low quality, deformed, extra people, crowd, cluttered desk, chaos, multiple objects, text, logo, watermark, border, frame, poster, flyer, overexposed, burnt, beach, ocean, water, snow

# =============================================================================
# Local LLM Configuration
# =============================================================================

# OpenAI-compatible local LLM endpoint used by the dashboard for topic suggestions
LOCAL_LLM_BASE_URL=http://localhost:8080/v1/chat/completions

# Exact model name exposed by your local server
LOCAL_LLM_MODEL=Qwen3.5-35B-A3B-GGUF

# Request timeout in seconds for local LLM calls
LOCAL_LLM_TIMEOUT_SECONDS=120

# Keep topic suggestion outputs short and fast
LOCAL_LLM_MAX_TOKENS=32

# Optional override for script generation. Leave unset to reuse LOCAL_LLM_MODEL.
# LOCAL_SCRIPT_MODEL=Qwen3.5-35B-A3B-GGUF

# Script generation needs a much larger token budget than topic suggestion
LOCAL_SCRIPT_MAX_TOKENS=1800

# Higher temperature helps the narration vary more by topic without getting too wild
LOCAL_SCRIPT_TEMPERATURE=0.7

# =============================================================================
# Database & Paths
# =============================================================================

# SQLite database path
DB_PATH=./stoic.db

# Output directory for jobs
JOBS_DIR=./output/jobs
